# Server only. Never use VITE_ prefixes for credentials.
DOUBAO_API_KEY=
# TTS uses the same server-side API key. Pick a voice ID from the console voice library.
DOUBAO_TTS_SPEAKER=
DOUBAO_TTS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
DOUBAO_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_ENABLE_AGE=true
DOUBAO_ENABLE_GENDER=true
DOUBAO_ENABLE_EMOTION=true
DOUBAO_ENABLE_SPEAKER=true
# Add the exact HTTPS origin used by your authenticated reverse proxy for deployment.
ASR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000
# Optional; defaults to ASR_ALLOWED_ORIGINS.
TTS_ALLOWED_ORIGINS=

# Agent model provider. Server-only; never prefix with VITE_.
ASXS_CODE_API_KEY=
AGENT_MODEL_BASE_URL=https://api.adjez.sbs/v1
AGENT_MODEL=gpt-5.6-terra
AGENT_MODEL_API=responses
AGENT_MODEL_TIMEOUT_MS=60000
AGENT_MAX_STEPS=8
AGENT_MAX_CONCURRENT=2

# Leave MCP_SERVER_URL empty to use the in-process Demo MCP server.
# Set it to the backend-maintained Streamable HTTP endpoint in production.
MCP_SERVER_URL=
MCP_CLIENT_TOKEN=
MCP_DEMO_SECRET=replace-with-a-demo-secret
